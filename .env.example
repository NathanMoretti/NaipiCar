# Copie este arquivo para .env e ajuste os valores.
# O .env NÃO vai para o GitHub (está no .gitignore).

# --- Django ---
# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta
DEBUG=True
# Separados por vírgula. Com DEBUG=True pode ficar vazio.
ALLOWED_HOSTS=

# --- Publicação (só quando o site for para a internet) ---
# DEBUG=False exige uma SECRET_KEY própria (o sistema não inicia com a chave de exemplo).
# Endereço completo do site, ex.: https://naipicar.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=
# True quando o site estiver com HTTPS (cookies seguros, redireciona http -> https)
USAR_HTTPS=False

# --- Banco de dados ---
# sqlite (padrão, não precisa instalar nada) ou mysql
DB_ENGINE=sqlite

# Usados apenas com DB_ENGINE=mysql
# pymysql (padrão) ou mysqlclient
DB_DRIVER=pymysql
DB_NAME=naipicar
DB_USER=naipicar
DB_PASSWORD=sua_senha_forte
DB_HOST=127.0.0.1
DB_PORT=3306
